# --- Database (Neon) ---
# Get this from your Neon project -> Connection Details -> "Pooled connection"
DATABASE_URL="postgresql://user:password@ep-xxxx-pooler.region.aws.neon.tech/bmmu?sslmode=require"

# --- App session security ---
# Generate with:  openssl rand -base64 32
AUTH_SECRET=""

# --- Google Drive backup (see README "Google Drive setup") ---
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""
GOOGLE_REFRESH_TOKEN=""
# The Drive folder ID that all scans will be organised into (create a folder
# in your Drive named e.g. "BMMU Attendance Archive" and copy the ID from its URL)
GOOGLE_DRIVE_FOLDER_ID=""

# --- Optional: "Continue with Google" sign-in (separate from Drive backup above) ---
# Only works for a Google email that already matches an existing staff
# account's email field - it does not open sign-up to anyone. Leave both
# blank to hide the Google button entirely and use username/password only.
GOOGLE_LOGIN_CLIENT_ID=""
GOOGLE_LOGIN_CLIENT_SECRET=""

# --- One-time admin account created by `npm run seed` ---
SEED_ADMIN_USERNAME="admin"
SEED_ADMIN_PASSWORD="ChangeMe123!"
SEED_ADMIN_NAME="BMMU Administrator"
